# 站点 URL（部署到自己的服务器时必填）
# 本地开发不需要，使用 http://localhost:3000 即可
NUXT_PUBLIC_SITE_URL=https://askoutsider.com/project/fortune

# 通义千问 API Key (阿里云 DashScope)
# 获取地址: https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-your-qwen-api-key

# DeepSeek API Key
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 小豆易支付：仅服务端读取；上线前配置密钥、持久卷并完成真实付款验证
PAYMENTS_ENABLED=false
PAYMENT_GATEWAY=https://pay.xiaodouap.cn/submit.php
PAYMENT_PID=49616103
PAYMENT_KEY=
PAYMENT_DB_PATH=.data/billing.sqlite
# 仅在 Nginx 覆盖 X-Real-IP，且容器仅监听 127.0.0.1 时设为 true
PAYMENT_TRUST_PROXY=false
